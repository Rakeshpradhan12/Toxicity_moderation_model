# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
REQUIRE_API_KEY=false
API_KEYS=your_api_key_1,your_api_key_2

# Module Toggles
ENABLE_TEXT_MODERATION=true
ENABLE_IMAGE_MODERATION=true
LOAD_MODELS_AT_STARTUP=true

# AWS S3 Configuration (for auto-downloading model weights if missing locally)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-2
MODEL_S3_BUCKET=nagatharun

# Text Model Settings
TEXT_MODEL_DIR=models/ft_best
TEXT_MODEL_S3_PREFIX=ml-models/ft_best/v1/

# Image Model Settings
NSFW_MODEL=weights/nsfw_image
NSFW_S3_PREFIX=ml-models/image-moderation/v1/nsfw_image/

CLIP_ENABLED=true
CLIP_LIGHT_DIR=weights/clip_light
CLIP_LIGHT_S3_PREFIX=ml-models/image-moderation-clip-light/v1/

CLIP_MODEL=weights/clip
CLIP_S3_PREFIX=ml-models/image-moderation/v1/clip/

# Image Limits & Thresholds
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_FRAMES=3
NSFW_REVIEW_THRESHOLD=0.50
NSFW_BLOCK_THRESHOLD=1.01
CLIP_REVIEW_THRESHOLD=0.70
MAX_CONCURRENT_INFERENCE=2
QUEUE_TIMEOUT_SECONDS=10
